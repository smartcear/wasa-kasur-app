rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/wasaUsers/$(request.auth.uid)).data; }
    function role(r) { return signedIn() && profile().role == r; }
    function superAdmin() { return role('superadmin'); }
    function admin() { return superAdmin() || role('admin'); }
    function manager() { return admin() || role('manager'); }
    function canBillDownload() { return signedIn() && (profile().canDownloadBills == true || manager()); }
    function canConsumerDownload() { return signedIn() && (profile().canDownloadConsumerData == true || manager()); }

    match /wasaUsers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if signedIn() && (request.auth.uid == uid || admin());
      allow update: if admin() || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoUrl','gender','updatedAt']));
      allow delete: if admin() && uid != request.auth.uid;
    }

    match /wasaSettings/{doc} { allow read: if signedIn(); allow write: if admin(); }
    match /wasaZones/{doc} { allow read: if signedIn(); allow write: if admin(); }
    match /wasaAreas/{doc} { allow read: if signedIn(); allow write: if admin(); }
    match /wasaActivityTypes/{doc} { allow read: if signedIn(); allow write: if admin(); }

    match /wasaActivities/{doc} {
      allow read: if manager() || (signedIn() && resource.data.officerUid == request.auth.uid);
      allow create: if signedIn() && (manager() || request.resource.data.officerUid == request.auth.uid);
      allow update: if manager() || (signedIn() && resource.data.officerUid == request.auth.uid);
      allow delete: if superAdmin();
    }

    match /wasaBulkData/{doc} {
      allow read: if signedIn();
      allow create, update: if admin();
      allow delete: if admin();
    }
    match /wasaConsumers/{doc} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /wasaPendingRequests/{doc} { allow read, write: if admin() || (signedIn() && request.auth.uid == resource.data.uid); }
    match /wasaCorrectionRequests/{doc} { allow read, write: if manager() || (signedIn() && request.resource.data.officerUid == request.auth.uid); }
    match /wasaCorrections/{doc} { allow read, write: if manager() || (signedIn() && resource.data.officerUid == request.auth.uid); }
    match /wasaDuplicates/{doc} { allow read, write: if admin(); }
    match /wasaNotifications/{doc} { allow read, write: if signedIn(); }
    match /wasaAuditLog/{doc} { allow read: if superAdmin(); allow create: if manager(); }

    match /wasaBillBatches/{doc} { allow read: if manager() || canBillDownload(); allow create, update, delete: if admin(); }
    match /wasaConsumerBills/{doc} { allow read: if canBillDownload(); allow create, update, delete: if admin(); }

    match /wasaChats/{doc} { allow read, write: if signedIn(); }
    match /wasaMessages/{doc} { allow read, write: if signedIn(); }
    match /wasaCalls/{doc} { allow read, write: if signedIn(); }
    match /wasaCallRecordings/{doc} { allow read: if superAdmin(); allow create: if signedIn(); allow update, delete: if superAdmin(); }
    match /wasaPasswordResets/{doc} { allow create: if signedIn(); allow read, update, delete: if admin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
