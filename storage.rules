rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() { return firestore.get(/databases/(default)/documents/wasaUsers/$(request.auth.uid)).data; }
    function admin() { return signedIn() && (profile().role == 'superadmin' || profile().role == 'admin'); }
    function canBillDownload() { return signedIn() && (admin() || profile().role == 'manager' || profile().canDownloadBills == true); }

    match /wasaBills/{batchId}/master/{fileName} {
      allow write: if admin()
                   && request.resource.contentType == 'application/pdf'
                   && request.resource.size < 200 * 1024 * 1024;
      allow read: if canBillDownload();
      allow delete: if admin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
